{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'group:monorepos',
    'group:recommended',
    'helpers:pinGitHubActionDigestsToSemver',
  ],
  semanticCommits: 'disabled',
  packageRules: [
    {
      matchUpdateTypes: [
        'major',
        'minor',
        'patch'
      ],
      minimumReleaseAge: '3 days',
    },
    {
      "matchPackageNames": [
        'dev.jonpoulton*',
      ],
      minimumReleaseAge: '0 days',
    }
  ]
}
