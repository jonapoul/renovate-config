{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
    "config:recommended",
    "group:monorepos",
    "group:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
  ],
  semanticCommits: "disabled",
  packageRules: [
    {
      // Check for GitHub Actions updates every Sunday morning, grouped into a single PR
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions",
      "schedule": [
        "* 0-8 * * 0"
      ]
    },
    {
      // Most dependencies wait 7 days
      matchUpdateTypes: [
        "major",
        "minor",
        "patch"
      ],
      minimumReleaseAge: "7 days",
    },
    {
      // My libraries update same-day
      "matchPackageNames": [
        "dev.jonpoulton*",
      ],
      minimumReleaseAge: "0 days",
    },
    {
      // AGP versions are often hardcoded in settings.gradle.kts as well as the version catalog, so
      // force them into the same group as the catalog's "agp" version ref. Listed explicitly
      // because com.android.* would also swallow com.android.tools:desugar_jdk_libs
      "matchDepNames": [
        "com.android.application",
        "com.android.kotlin.multiplatform.library",
        "com.android.lint"
      ],
      "groupName": "AGP"
    },
    {
      // Same for blueprint, which can also be referenced by artifacts in the catalog
      "matchDepNames": [
        "dev.jonpoulton.blueprint*"
      ],
      "groupName": "blueprint"
    },
    {
      // Same for Kotlin. Two globs so we catch plugin IDs and artifacts, but not org.jetbrains.kotlinx
      "matchDepNames": [
        "org.jetbrains.kotlin.*",
        "org.jetbrains.kotlin:*"
      ],
      "groupName": "kotlin"
    }
  ]
}
